{"26:3": "﴿بَاخِعٌ﴾ مُهْلِكٌ.", "26:5": "﴿مُحْدَثٍ﴾ حَدِيثِ النُّزُولِ.", "26:7": "﴿زَوْجٍ كَرِيمٍ﴾ نَوْعٍ حَسَنٍ نَافِعٍ.", "26:21": "﴿حُكْمًا﴾ النُّبُوَّةَ.", "26:20": "﴿الضَّآلِّينَ﴾ الجَاهِلِينَ، وَذَلِكَ قَبْلَ أَن يُّوحَى إليَّ.", "26:22": "﴿عَبَّدْتَّ﴾ جَعَلْتَهُمْ عَبِيدًا.", "26:33": "﴿وَنَزَعَ يَدَهُ﴾ أَخْرَجَهَا مِنْ جَيْبِهِ.", "26:36": "﴿أَرْجِهْ﴾ أَخِّرْهُ.\n﴿حَاشِرِينَ﴾ جُنُودًا يَجْمَعُونَ السَّحَرَةَ.", "26:44": "﴿بِعِزَّةِ فِرْعَوْنَ﴾ أَقْسَمُوا بِعِزَّتِهِ، وَقُوَّتِهِ.", "26:45": "﴿تَلْقَفُ﴾ تَبْتَلِعُ بِسُرْعَةٍ.\n﴿مَا يَأْفِكُونَ﴾ مَا يَفْعَلُونَهُ مِنَ الكَذِبِ وَالتَّزْوِيرِ.", "26:49": "﴿مِنْ خِلاَفٍ﴾ بِقَطْعِ اليَدِ اليُمْنَى وَالرِّجْلِ اليُسْرَى، أَوْ عَكْسَ ذَلِكَ.", "26:50": "﴿لاَ ضَيْرَ﴾ لاَ ضَرَرَ.\n﴿مُنْقَلِبُونَ﴾ رَاجِعُونَ.", "26:54": "﴿لَشِرْذِمَةٌ﴾ لطَائِفَةٌ حَقِيرَةٌ.", "26:53": "﴿حَاشِرِينَ﴾ جَامِعِينَ لِلْجَيْشِ مِنَ المَدَائِنِ.", "26:58": "﴿وَكُنُوزٍ﴾ خَزَائِنِ الأَمْوَالِ.\n﴿وَمَقَامٍ كَرِيمٍ﴾ مَنَازِلَ حِسَانٍ.", "26:60": "﴿مُشْرِقِينَ﴾ وَقْتَ شُرُوقِ الشَّمْسِ.", "26:61": "﴿تَرَاءَى الْجَمْعَانِ﴾ رَأَى كُلُّ فَرِيقٍ الآخَرَ.", "26:63": "﴿فِرْقٍ﴾ قِطْعَةٍ مِنَ البَحْرِ.\n﴿كَالطَّوْدِ﴾ كَالجَبَلِ.", "26:64": "﴿وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ﴾ قَرَّبْنَا هُنَاكَ، فِرَعْوَنَ، وَقَوْمَهُ.", "26:71": "﴿عَاكِفِينَ﴾ مُقِيمِينَ عَلَى عِبَادَتِهَا.", "26:75": "﴿أَفَرَأَيْتُمْ﴾ أَبْصَرْتُمْ بِتَدَبُّرٍ.", "26:83": "﴿حُكْمًا﴾ عِلْمًا وَفَهْمًا.", "26:84": "﴿لِسَانَ صِدْقٍ﴾ ثَنَاءً حَسَنًا.\n﴿الآخَرِينَ﴾ مَنْ يَأْتُونَ بَعْدِي إِلَى يَوْمِ القِيَامَةِ.", "26:89": "﴿سَلِيمٍ﴾ سَالِمٍ مِنَ الشِّرْكِ وَالنِّفَاقِ وَالضَّغِينَةِ.", "26:90": "﴿وَأُزْلِفَتِ﴾ قُرِّبَتْ.", "26:91": "﴿وَبُرِّزَتِ﴾ أُظْهِرَتْ.", "26:94": "﴿فَكُبْكِبُوا﴾ فَجُمِعُوا، وَأُلْقُوا.", "26:101": "﴿حَمِيمٍ﴾ مُشْفِقٍ يَهْتَمُّ بِأَمْرِنَا.", "26:102": "﴿كَرَّةً﴾ رَجْعَةً إِلَى الدُّنْيَا.", "26:111": "﴿الأَرْذَلُونَ﴾ السَّفَلَةُ مِنَ النَّاسِ.", "26:116": "﴿الْمَرْجُومِينَ﴾ المَقْتُولِينَ رَمْيًا بِالحِجَارَةِ.", "26:119": "﴿الْمَشْحُونِ﴾ المَمْلُوءِ بِالنَّاسِ، وَالدَّوَابِّ، وَالمَتَاعِ.", "26:118": "﴿فَافْتَحْ﴾ احْكُمْ.", "26:128": "﴿رِيعٍ﴾ مَكَانٍ مُرْتَفِعٍ.\n﴿آيَةً﴾ بِنَاءً عَالِيًا.\n﴿تَعْبَثُونَ﴾ تُشْرِفُونَ مِنْهُ فَتَسْخَرُونَ مِنَ المَارَّةِ.", "26:129": "﴿مَصَانِعَ﴾ قُصُورًا مَنِيعَةً وَحُصُونًا مُشَيَّدَةً.", "26:132": "﴿أَمَدَّكُمْ﴾ أَعْطَاكُمْ وَأَنْعَمَ عَلَيْكُمْ.", "26:136": "﴿سَوَاءٌ عَلَيْنَا﴾ يَسْتَوِي عِنْدَنَا.\n﴿أَوَعَظْتَ﴾ أَخَوَّفْتَ.", "26:137": "﴿خُلُقُ﴾ دِينُ، وَعَادَةُ.", "26:148": "﴿طَلْعُهَا هَضِيمٌ﴾ ثَمَرُهَا يَانِعٌ لَيِّنٌ نَضِيجٌ.", "26:149": "﴿فَارِهِينَ﴾ مَاهِرِينَ بِنَحْتِهَا أَشِرِينَ بَطِرِينَ.", "26:151": "﴿الْمُسْرِفِينَ﴾ المُتَمَادِينَ فِي مَعْصِيَةِ اللهِ.", "26:153": "﴿الْمُسَحَّرِينَ﴾ المَغْلُوبِ عَلَى عُقُولِهِمْ بِكَثْرَةِ السِّحْرِ.", "26:155": "﴿شِرْبٌ﴾ نَصِيبٌ مِنَ المَاءِ.", "26:157": "﴿فَعَقَرُوهَا﴾ نَحَرُوهَا.", "26:166": "﴿عَادُونَ﴾ مُتَجَاوِزُونَ مَا أَبَاحَهُ اللهُ لَكُمْ مِنَ الحَلاَلِ إِلَى الحَرَامِ.", "26:167": "﴿الْمُخْرَجِينَ﴾ المَطْرُودِينَ مِنْ بِلاَدِنَا.", "26:168": "﴿الْقَالِينَ﴾ المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا.", "26:171": "﴿الْغَابِرِينَ﴾ البَاقِينَ فِي العَذَابِ.", "26:173": "﴿فَسَاءَ﴾ قَبُحَ.", "26:176": "﴿أَصْحَابُ الأَيْكَةِ﴾ أَصْحَابُ الأَرْضِ ذَاتِ الشَّجَرِ المُلْتَفِّ؛ وَهُمْ قَوْمُ شُعَيْبٍ.", "26:181": "﴿الْمُخْسِرِينَ﴾ النَّاقِصِينَ لِحُقُوقِ النَّاسِ.", "26:182": "﴿بِالْقِسْطَاسِ﴾ بِالمِيزَانِ.\n﴿الْمُسْتَقِيمِ﴾ العَدْلِ السَّوِيِّ.", "26:183": "﴿وَلاَ تَبْخَسُوا﴾ لاَ تُنْقصوا.\n﴿وَلاَ تَعْثَوْا﴾ لاَ تُكْثِرُوا الفَسَادَ.", "26:184": "﴿وَالْجِبِلَّةَ الْأَوَّلِينَ﴾ الخَلِيقَةَ وَالأُمَمَ المَاضِينَ.", "26:185": "﴿الْمُسَحَّرِينَ﴾ مَنْ أَصَابَهُمْ سِحْرٌ شَدِيدٌ، فَذَهَبَ بِعُقُولِهِمْ.", "26:187": "﴿كِسَفًا﴾ قِطَعًا مِنَ العَذَابِ.", "26:189": "﴿الظُّلَّةِ﴾ سَحَابَةٍ أَظَلَّتْهُمْ وَجَدُوا تَحْتَهَا بَرْدًا، فَلمَّا اجْتَمَعُوا أَحْرَقَتْهُمْ بِنَارِهَا.", "26:193": "﴿الرُّوحُ الأَمِينُ﴾ جِبْرِيلُ عليه السلام.", "26:196": "﴿زُبُرِ الأَوَّلِينَ﴾ كُتُبِ الأَنْبِيَاءِ السَّابِقِينَ.", "26:197": "﴿آيَةً﴾ عَلاَمَةً عَلَى صِحَّةِ نُبُوَّتِكَ.", "26:198": "﴿الأَعْجَمِينَ﴾ الَّذِينَ لاَ يَتَكَلَّمُونَ العَرَبِيَّةَ.", "26:200": "﴿سَلَكْنَاهُ﴾ أَدْخَلْنَا التَّكْذِيبَ.", "26:202": "﴿بَغْتَةً﴾ فَجْأَةً.", "26:203": "﴿مُنْظَرُونَ﴾ مُمْهَلُونَ مُؤَخَّرُونَ.", "26:205": "﴿أَفَرَأَيْتَ﴾ أَفَعَلِمْتَ؟", "26:212": "﴿السَّمْعِ﴾ اسْتِمَاعِ القُرْآنِ مِنَ السَّمَاءِ.\n﴿لَمَعْزُولُونَ﴾ لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ.", "26:215": "﴿وَاخْفِضْ جَنَاحَكَ﴾ أَلِنْ جَانِبَكَ وَكَلامَكَ تَوَاضُعًا.", "26:218": "﴿حِينَ تَقُومُ﴾ تُصَلِّي اللَّيْلَ وَحْدَكَ.", "26:222": "﴿أَفَّاكٍ﴾ كَذَّابٍ.\n﴿أَثِيمٍ﴾ كَثِيرِ الآثَامِ.", "26:223": "﴿يُلْقُونَ السَّمْعَ﴾ تُلْقِي الشَّيَاطِينُ إِلَى الكُهَّانِ مَا يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلَى.", "26:225": "﴿وَادٍ﴾ فَنٍّ مِنْ فُنُونِ البَاطِلِ، وَالكَذِبِ.\n﴿يَهِيمُونَ﴾ يَخُوضُونَ.", "26:227": "﴿مُنْقَلَبٍ﴾ مَرْجِعٍ."}